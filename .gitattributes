# Normalise line endings in the repository, and keep LF in the working tree for anything
# that Linux executes. A shell script checked out with CRLF fails on the server with
# "bad interpreter: /usr/bin/env bash^M", which is a painful way to learn this.
* text=auto eol=lf

*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.conf    text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.sql     text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf

# Windows-only helpers keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
