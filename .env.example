#############################################
# QR ALTRIX — environment configuration
# Copy to .env and fill in real values.
#############################################

# --- Core -----------------------------------------------------------------
NODE_ENV=production
# Public base URL of the app (no trailing slash)
APP_URL=https://qr.example.com
# Short-link base used when no custom domain is selected
SHORT_URL_BASE=https://qr.example.com
APP_NAME="QR ALTRIX"
PORT=3000

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://qraltrix:change-me@localhost:5432/qraltrix?schema=public

# --- Redis (optional) -----------------------------------------------------
# When unset, background jobs run inline in the web process. Set it in
# production so scan logging and bulk imports are processed by the worker.
REDIS_URL=redis://localhost:6379

# --- Secrets (generate with: openssl rand -hex 32) ------------------------
AUTH_SECRET=replace-with-64-char-random-hex
IP_HASH_SALT=replace-with-32-char-random-hex

# --- Email (SMTP). Leave SMTP_HOST empty to log mails to stdout instead. --
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="QR ALTRIX <no-reply@example.com>"

# --- Google OAuth (optional) ---------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Storage --------------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_MB=15

# S3-compatible (only when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true

# --- Platform behaviour ---------------------------------------------------
# Allow visitors to download static QR codes without an account
ALLOW_GUEST_STATIC_DOWNLOAD=true
# Scan analytics retention in days (0 = keep forever)
ANALYTICS_RETENTION_DAYS=0
# Store a salted hash of visitor IPs only (recommended). never = store nothing.
IP_STORAGE_MODE=hashed
# Abuse protection limits (not product limits — QR codes are unlimited and free)
RATE_LIMIT_API_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=10
BULK_MAX_ROWS=20000

# --- Database connection pool used by the worker --------------------------
WORKER_CONCURRENCY=5

# --- Backups --------------------------------------------------------------
# Where scripts/backup.sh writes, and where the admin panel looks to report
# backup freshness. The app only reads this directory, never writes to it.
BACKUP_DIR=./backups
